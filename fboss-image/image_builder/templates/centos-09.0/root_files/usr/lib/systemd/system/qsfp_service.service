# /usr/lib/systemd/system/qsfp_service.service
[Unit]
Description=FBOSS QSFP Service
After=platform_manager.service
After=rc-local.service
Wants=fboss_init.service
After=fboss_init.service
# Unlimited restarts (no start limit hit within a given time period)
StartLimitIntervalSec=0

[Service]
Type=simple
LimitNOFILE=10000000
LimitCORE=32G
MemoryMax=3.75G
MemorySwapMax=0

Environment="PATH=/opt/fboss/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin"
Environment="LD_LIBRARY_PATH=/opt/fboss/lib"
WorkingDirectory=/opt/fboss
ExecStart=/bin/bash -c 'source /opt/fboss/bin/setup_fboss_env && exec /opt/fboss/bin/qsfp_service $$([ -f /run/fboss/variant_flags ] && echo --flagfile=/run/fboss/variant_flags) --fsdb_client_ssl_preferred=false --thrift_ssl_policy=disabled'

Restart=always
RestartSec=3
TimeoutStartSec=180s

StandardOutput=append:/var/facebook/logs/fboss/qsfp_service.log
StandardError=append:/var/facebook/logs/fboss/qsfp_service.log

[Install]
WantedBy=multi-user.target
