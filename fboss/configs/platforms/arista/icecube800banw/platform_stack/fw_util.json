{
  "fwConfigs": {
    "bios": {
      "upgrade": [
        {
          "commandType": "flashrom",
          "flashromArgs": {
            "programmer_type": "internal"
          }
        }
      ],
      "verify": {
        "commandType": "flashrom",
        "flashromArgs": {
          "programmer_type": "internal"
        }
      },
      "read": {
        "commandType": "flashrom",
        "flashromArgs": {
          "programmer_type": "internal"
        }
      },
      "version": {
        "versionType": "sysfs",
        "path": "/sys/devices/virtual/dmi/id/bios_version"
      },
      "priority": 3
    },
    "scm_cpld": {
      "upgrade": [
        {
          "commandType": "jam",
          "jamArgs": {
            "jamExtraArgs": [
              "-aprogram",
              "-fmarconi_cpu_cpld",
              "-v"
            ]
          }
        }
      ],
      "version": {
        "versionType": "sysfs",
        "path": "/run/devmap/inforoms/SCM_FPGA_INFO_ROM/fw_ver"
      },
      "priority": 2
    },
    "smb_fpga": {
      "upgrade": [
        {
          "commandType": "flashrom",
          "flashromArgs": {
            "spi_layout": "0:3FFFFF image",
            "programmer_type": "linux_spi:dev=",
            "programmer": "/run/devmap/flashes/SMB_SPI_MASTER0_DEVICE1",
            "flashromExtraArgs": [
              "-i",
              "image"
            ],
            "chip": [
              "MT25QL256",
              "MX25L25635F/MX25L25645G"
            ]
          }
        }
      ],
      "version": {
        "versionType": "sysfs",
        "path": "/run/devmap/inforoms/SMB_FPGA_INFO_ROM/fw_ver"
      },
      "priority": 1
    }
  }
}
