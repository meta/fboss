load("@fbcode_macros//build_defs:python_binary.bzl", "python_binary")
load("@fbcode_macros//build_defs:python_library.bzl", "python_library")

oncall("fboss_oss")

python_library(
    name = "component_version",
    srcs = ["component_version.py"],
)

python_library(
    name = "package_fboss_lib",
    srcs = {"package-fboss.py": "package_fboss.py"},
    deps = [
        ":component_version",
        ":platform_configs_utils",
    ],
)

python_library(
    name = "platform_configs_utils",
    srcs = ["platform_configs_utils.py"],
    labels = ["autodeps2_generated"],
)

python_library(
    name = "sdk_versions",
    srcs = ["sdk_versions.py"],
    labels = ["autodeps2_generated"],
)

python_library(
    name = "npu_sdk_utils_lib",
    srcs = ["npu_sdk_utils.py"],
    # The OSS package installs this beside its callers in /opt/fboss/bin.
    # @lint-ignore BUCKLINT no_base_module_usage_python
    base_module = "",
    labels = ["autodeps2_generated"],
)

python_binary(
    name = "npu_sdk_utils",
    main_module = "npu_sdk_utils",
    deps = [":npu_sdk_utils_lib"],
)

python_library(
    name = "package_lib",
    srcs = ["package.py"],
    labels = ["autodeps2_generated"],
    deps = [
        ":component_version",
        ":platform_configs_utils",
    ],
)

python_binary(
    name = "package",
    main_module = "fboss.oss.scripts.package",
    deps = [":package_lib"],
)

python_library(
    name = "getdeps_fallback_mirror_lib",
    srcs = ["getdeps_fallback_mirror.py"],
    labels = ["autodeps2_generated"],
)

python_library(
    name = "compile_mem_lib",
    srcs = ["compile_mem.py"],
    # Tests import this as a top-level module, like npu_sdk_utils_lib.
    # @lint-ignore BUCKLINT no_base_module_usage_python
    base_module = "",
    labels = ["autodeps2_generated"],
)

python_library(
    name = "check_copyright_headers_lib",
    srcs = ["check_copyright_headers.py"],
)

python_binary(
    name = "check_copyright_headers",
    main_module = "fboss.oss.scripts.check_copyright_headers",
    deps = [":check_copyright_headers_lib"],
)

python_binary(
    name = "check_compile_mem",
    main_module = "compile_mem",
    deps = [":compile_mem_lib"],
)

python_binary(
    name = "getdeps_fallback_mirror",
    main_module = "fboss.oss.scripts.getdeps_fallback_mirror",
    deps = [":getdeps_fallback_mirror_lib"],
)
