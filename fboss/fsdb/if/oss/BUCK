load("@fbsource//tools/target_determinator/macros:ci_sandcastle.bzl", "ci_sandcastle")
load("//fboss/thriftpath_plugin/facebook:thriftpath_plugin.bzl", "thrift_plugin_thriftpath")

oncall("fboss_agent_push")

